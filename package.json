{
  "name": "stockswipe-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.21",
    "lucide-react-native": "1.60.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-purchases": "10.16.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-testing-library": "^7.16.2",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.9.10",
    "react-dom": "^19.3.0",
    "test-renderer": "^1.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "yahoo-finance2": "^4.0.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "maestro test e2e/flows",
    "e2e:parallel": "maestro test --shard-split 2 e2e/flows",
    "sync": "tsx jobs/sync/main.ts",
    "privacy": "tsx scripts/write-privacy.ts && prettier --write PRIVACY.md"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "jobs/**/*.ts",
      "!src/**/*.d.ts",
      "!src/test-utils.tsx"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 98,
        "branches": 95,
        "functions": 98,
        "lines": 98
      }
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "setupFilesAfterEnv": [
      "./jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^lucide-react-native/icons/(.*)$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/icons/$1.js"
    }
  },
  "overrides": {
    "@expo/cli": {
      "glob": "^14.0.3"
    },
    "@expo/fingerprint": {
      "glob": "^14.0.3",
      "minimatch": "^11.0.4"
    },
    "@jest/reporters": {
      "glob": "^14.0.3"
    },
    "jest-config": {
      "glob": "^14.0.3"
    },
    "jest-runtime": {
      "glob": "^14.0.3"
    },
    "test-exclude@7": {
      "glob": "^14.0.3",
      "minimatch": "^11.0.4"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.4"
    }
  }
}
