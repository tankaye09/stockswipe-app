# Copy to .env (or set in the EAS build profile). All are optional: without them the app
# runs in test mode with the defaults shown.

# Free tier (can also be changed for everyone in the RevenueCat dashboard; see README)
EXPO_PUBLIC_FREE_DAYS=7
EXPO_PUBLIC_FREE_DAILY_SWIPES=50
EXPO_PUBLIC_AD_EVERY_N_SWIPES=10

# Premium. Real prices are set in App Store Connect and Google Play; these show in test mode only.
EXPO_PUBLIC_PREMIUM_MONTHLY_PRICE=S$5.98
EXPO_PUBLIC_PREMIUM_ANNUAL_PRICE=S$48.98
EXPO_PUBLIC_PREMIUM_ENTITLEMENT=premium
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# AdMob 300x250 banner units for the in-feed ad card
EXPO_PUBLIC_ADMOB_FEED_UNIT_IOS=
EXPO_PUBLIC_ADMOB_FEED_UNIT_ANDROID=

# Broker referral links (empty = normal sign-up page)
EXPO_PUBLIC_REFERRAL_MOOMOO=
EXPO_PUBLIC_REFERRAL_TIGER=
EXPO_PUBLIC_REFERRAL_IBKR=

# Admin page. Development, internal test and e2e builds only. Never in store builds.
EXPO_PUBLIC_ADMIN_TOOLS=
